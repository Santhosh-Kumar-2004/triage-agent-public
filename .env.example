# ── Airflow connection ────────────────────────────────────────────────────────
AIRFLOW_URL=http://127.0.0.1:8088
AIRFLOW_USERNAME=admin
AIRFLOW_PASSWORD=admin
POLL_INTERVAL_SECONDS=30

# ── Email notifications (optional — agent runs without this) ──────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
ALERT_TO=your-email@gmail.com

# ── GitHub (optional — agent uses demo DAG code if not set) ──────────────────
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
GITHUB_REPO=your-org/your-dags-repo
GITHUB_REPO_LOCAL_PATH=C:/Users/you/repos/your-dags-repo
GITHUB_BASE_BRANCH=main

# ── LLM ───────────────────────────────────────────────────────────────────────
# Set LLM_PROVIDER to one of: deepinfra | anthropic | gemini
LLM_PROVIDER=deepinfra

# --- DeepInfra (default, recommended) ----------------------------------------
# Sign up at https://deepinfra.com  →  Dashboard → API Keys
# Pay-as-you-go, no minimum. DeepSeek-V4.1-Flash: ~$0.0003 per triage run.
# Model catalogue + prices: https://deepinfra.com/models/text-generation
#
# Cheap + good at coding:
#   deepseek-ai/DeepSeek-V4.1-Flash-1017   $0.098/$0.294 per 1M tokens
#   deepseek-ai/DeepSeek-V4-Flash-0731     $0.060/$0.180 per 1M tokens
#
# Heavy hitter (for hard cases):
#   deepseek-ai/DeepSeek-V4-Pro-0813       $1.30/$2.60 per 1M tokens
#
DEEPINFRA_API_KEY=di-xxxxxxxxxxxxxxxxxxxx
DEEPINFRA_MODEL=deepseek-ai/DeepSeek-V4.1-Flash-1017

# LLM_BASE_URL only needed to point at a different OpenAI-compatible host
# (Together, Fireworks, Groq, local Ollama, etc.). Leave commented for DeepInfra.
# LLM_BASE_URL=http://localhost:11434/v1   # example: local Ollama

# --- Anthropic (alternative) -------------------------------------------------
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx
# ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Google Gemini (original default, still works) ---------------------------
# GEMINI_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxx
# GEMINI_MODEL=gemini-3.8-flash

# ── Burr tracking UI (optional — run `burr` to open http://localhost:7241) ────
ENABLE_BURR_TRACKER=false
