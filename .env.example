# ── Email (IMAP) ──────────────────────────────────────────────────────────────
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USERNAME=your-email@gmail.com
IMAP_PASSWORD=your-gmail-app-password   # Settings → Security → App Passwords
IMAP_FOLDER=INBOX
IMAP_SUBJECT_FILTER=Airflow alert
POLL_INTERVAL_SECONDS=60

# ── GitHub ────────────────────────────────────────────────────────────────────
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
GITHUB_REPO=your-org/your-dags-repo
GITHUB_REPO_LOCAL_PATH=C:/Users/you/repos/your-dags-repo
GITHUB_BASE_BRANCH=main

# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# ── Burr tracking UI (optional — run `burr` to open http://localhost:7241) ────
ENABLE_BURR_TRACKER=false
